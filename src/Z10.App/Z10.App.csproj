<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-10-SDK-Projektionen für die Medienwiedergabe (System Media Transport Controls) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Z10.App</RootNamespace>
    <AssemblyName>Z10AppletEngine</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Produktversion ohne angehängten Commit-Hash ("1.2.3" statt "1.2.3+abc…"), damit die Signatur-Prüfung von SignPath passt -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Z10 Applet Engine</Product>
    <Description>Custom applets for the LCD of the EVGA Z10 keyboard</Description>
    <Authors>limetto</Authors>
    <Copyright>Copyright (c) 2026 limetto</Copyright>
    <RepositoryUrl>https://github.com/limetto/z10-applet-engine</RepositoryUrl>
    <!-- WPF steuert DPI über das Manifest; die WinForms-Empfehlung (nur für den Infobereich genutzt) passt hier nicht -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Z10.Core\Z10.Core.csproj" />
  </ItemGroup>

</Project>
