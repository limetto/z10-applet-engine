<UserControl x:Class="Z10.App.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Tastatur" Style="{StaticResource H2}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Gerät" Foreground="{StaticResource MutedBrush}" Margin="0,2,16,2"/>
            <TextBlock x:Name="DeviceInfo" Grid.Column="1" Text="–" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Status" Foreground="{StaticResource MutedBrush}" Margin="0,2,16,2"/>
            <TextBlock x:Name="DeviceStatus" Grid.Row="1" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock Grid.Row="2" Text="Schnittstelle" Foreground="{StaticResource MutedBrush}" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="3842:2601 · Usage Page 0xFF01" FontFamily="Consolas" Margin="0,2"/>
          </Grid>
          <Border Background="#2A2416" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12"
                       Text="Läuft EVGA Unleash, gibt die Engine das Display automatisch frei und übernimmt es wieder, sobald Unleash beendet ist."/>
          </Border>

          <TextBlock Text="Hintergrundbeleuchtung" Style="{StaticResource H2}" Margin="0,20,0,4"/>
          <DockPanel>
            <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
            <TextBlock Text="Helligkeit" Style="{StaticResource Label}"/>
          </DockPanel>
          <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="Backlight_Changed"/>
          <DockPanel>
            <TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
            <TextBlock Text="Kontrast" Style="{StaticResource Label}"/>
          </DockPanel>
          <Slider x:Name="ContrastSlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="Backlight_Changed"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Die Farbe des Displays stellst du unter „Beleuchtung“ ein."/>

          <TextBlock Text="Verhalten" Style="{StaticResource H2}" Margin="0,20,0,4"/>
          <TextBlock Text="Pause zwischen Display-Seiten" Style="{StaticResource Label}"/>
          <ComboBox x:Name="DelayBox" SelectionChanged="Delay_Changed"/>
          <CheckBox x:Name="ReleaseOnExitBox" Content="Beim Beenden Display an die Tastatur zurückgeben" Click="Behavior_Click" Margin="0,12,0,4"/>
          <CheckBox x:Name="BootBox" Content="Startanimation (auf der Tastatur und im Startfenster)" Click="Behavior_Click"/>
          <CheckBox x:Name="AutoStartBox" Content="Mit Windows starten (über die Aufgabenplanung, ohne UAC-Abfrage)" Click="AutoStart_Click"/>

          <TextBlock Text="Bildschirmschoner" Style="{StaticResource H2}" Margin="0,20,0,4"/>
          <CheckBox x:Name="SaverBox" Content="Bildschirmschoner auf dem Display" Click="Saver_Changed"/>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Nach" Style="{StaticResource Label}"/>
              <ComboBox x:Name="SaverMinutesBox" SelectionChanged="Saver_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Motiv" Style="{StaticResource Label}"/>
              <ComboBox x:Name="SaverKindBox" SelectionChanged="Saver_Changed"/>
            </StackPanel>
          </Grid>
          <CheckBox x:Name="SaverMouseBox" Content="Mausbewegungen zählen auch als Eingabe" Click="Saver_Changed" Margin="0,8,0,0"/>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Vorschau (10 s)" Click="SaverPreview_Click"/>
            <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Startet, wenn so lange keine Taste gedrückt wurde. Der erste Tastendruck beendet ihn (E-Tasten schalten dabei nicht weiter)."/>
          </DockPanel>

          <TextBlock Text="Tasten E6 / E7" Style="{StaticResource H2}" Margin="0,20,0,4"/>
          <CheckBox x:Name="KeysBox" Content="E-Tasten auswerten" Click="Keys_Changed"/>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="E6" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="E6Box" Grid.Column="1" Margin="0,4" SelectionChanged="Keys_Changed"/>
            <TextBlock Grid.Row="1" Text="E7" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="E7Box" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="Keys_Changed"/>
          </Grid>
          <TextBlock x:Name="KeysStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="–"/>

          <TextBlock Text="Weitere Datenquellen" Style="{StaticResource H2}" Margin="0,20,0,4"/>
          <CheckBox x:Name="RtssBox" Content="RTSS (Framerate, Frametime)" Click="Sources_Click"/>
          <TextBlock x:Name="RtssStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
          <CheckBox x:Name="AfterburnerBox" Content="MSI Afterburner (alle Überwachungswerte)" Click="Sources_Click"/>
          <TextBlock x:Name="AfterburnerStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
          <CheckBox x:Name="AudioBox" Content="Lautstärke der Audiogeräte" Click="Sources_Click"/>
          <TextBlock x:Name="AudioStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                     Text="Framerate gibt es nur, wenn der RivaTuner Statistics Server läuft. Er ist ein eigenes Programm (Symbol im Infobereich), das mit Afterburner installiert wird. Afterburner allein liefert keine FPS."/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Sensoren" Style="{StaticResource H2}"/>
        <TextBlock DockPanel.Dock="Top" x:Name="SensorError" Foreground="#FFB3B5" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="In Formel einfügen" Click="InsertId_Click" Margin="8,0,0,0"
                  ToolTip="Fügt den markierten Sensor in die Formel des eigenen Sensors ein"/>
          <Button DockPanel.Dock="Right" Content="Id kopieren" Click="CopyId_Click" Margin="8,0,0,0"/>
          <TextBox x:Name="FilterBox" TextChanged="Filter_Changed" ToolTip="Filter, z. B. temperature, load, fan"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Die Id kannst du im Layout-Editor als Sensor eintragen. Werte aktualisieren sich jede Sekunde."/>
        <DataGrid x:Name="SensorGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Hardware" Binding="{Binding Hardware}" Width="2*"/>
            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*"/>
            <DataGridTextColumn Header="Wert" Binding="{Binding ValueText}" Width="*"/>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Eigene Sensoren" Style="{StaticResource H2}"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Neu" Click="CustomAdd_Click" Margin="0,0,6,0"/>
            <Button Content="Löschen" Click="CustomDelete_Click"/>
          </StackPanel>
          <ListBox x:Name="CustomList" Height="150" SelectionChanged="CustomList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Id}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <StackPanel Grid.Column="2" x:Name="CustomEditor">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Name" Style="{StaticResource Label}"/>
              <TextBox x:Name="CustomName" TextChanged="Custom_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Kurzname (Id)" Style="{StaticResource Label}"/>
              <TextBox x:Name="CustomKey" TextChanged="Custom_Changed" FontFamily="Consolas"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Einheit" Style="{StaticResource Label}"/>
              <TextBox x:Name="CustomUnit" TextChanged="Custom_Changed"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Formel" Style="{StaticResource Label}"/>
          <TextBox x:Name="CustomFormula" TextChanged="Custom_Changed" FontFamily="Consolas" AcceptsReturn="False"/>
          <TextBlock x:Name="CustomResult" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                     Text="Sensoren in [ ] schreiben, z. B. max([auto:cpu/Temperature/*], [auto:gpu/Temperature/*]). Erlaubt: + − * / ^ ( ), min, max, avg, sum, abs, round(x, Stellen), clamp(x, min, max). Dezimalpunkt verwenden. Eigene Sensoren dürfen weiter oben stehende eigene Sensoren verwenden."/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource AccentButton}" Content="Eigene Sensoren speichern" Click="CustomSave_Click"/>
            <TextBlock x:Name="CustomSaved" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
