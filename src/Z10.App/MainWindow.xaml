<Window x:Class="Z10.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Z10.App"
        Title="Z10 Applet Engine" Width="1280" Height="860" MinWidth="980" MinHeight="640"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="app.ico"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="logo.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Z10 Applet Engine" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="ReleaseButton" DockPanel.Dock="Right" Content="Display freigeben" Click="Release_Click" Margin="12,0,0,0"
                ToolTip="Gibt das Display an die Tastatur zurück (Uhr, Profilanzeige der Firmware)"/>
        <Border x:Name="SensorChip" DockPanel.Dock="Right" CornerRadius="12" Padding="10,4" Margin="8,0,0,0" Background="#1F2A22" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="SensorDot" Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SensorText" Text="LibreHardwareMonitor" FontSize="12" Foreground="#9BE3AE"/>
          </StackPanel>
        </Border>
        <Border x:Name="ProfileChip" DockPanel.Dock="Right" CornerRadius="12" Padding="10,2" Margin="8,0,0,0" Background="#1C2230" VerticalAlignment="Center"
                ToolTip="Aktives Profil der Tastatur. Klick wechselt das Profil (Beleuchtung und Displayfarbe gelten je Profil).">
          <StackPanel x:Name="ProfilePanel" Orientation="Horizontal">
            <TextBlock Text="Profil" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="DeviceChip" DockPanel.Dock="Right" CornerRadius="12" Padding="10,4" Background="#1F2A22" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DeviceDot" Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DeviceText" Text="Suche Tastatur …" FontSize="12" Foreground="#9BE3AE"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#15161A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,18">
        <StackPanel>
          <RadioButton x:Name="NavApplets" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked" Content="Applets"/>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Content="Layout-Editor"/>
          <RadioButton x:Name="NavLighting" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Content="Beleuchtung"/>
          <RadioButton x:Name="NavDevice" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Content="Gerät &amp; Sensoren"/>
          <RadioButton x:Name="NavOptions" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked" Content="Optionen"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" x:Name="ContentHost"/>
    </Grid>
  </Grid>
</Window>
