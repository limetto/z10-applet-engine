<UserControl x:Class="Z10.App.AppletsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Rotation -->
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="+ Applet" Click="Add_Click"/>
          <TextBlock Text="Applet-Rotation" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                   Text="Aktive Applets wechseln automatisch. Klick zeigt ein Applet sofort auf der Tastatur."/>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="▲" ToolTip="Nach oben" Click="Up_Click" Margin="0,0,6,6" MinWidth="40"/>
          <Button Content="▼" ToolTip="Nach unten" Click="Down_Click" Margin="0,0,6,6" MinWidth="40"/>
          <Button Content="Duplizieren" Click="Duplicate_Click" Margin="0,0,6,6"/>
          <Button Content="Löschen" Click="Delete_Click" Margin="0,0,6,6"/>
        </WrapPanel>
        <ListBox x:Name="List" SelectionChanged="List_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="aktiv" IsChecked="{Binding Enabled, Mode=OneWay}"
                          Click="Enabled_Click" Tag="{Binding}" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                    <Run Text="{Binding Widgets.Count, Mode=OneWay}"/><Run Text=" Bausteine · "/><Run Text="{Binding DurationSeconds, Mode=OneWay}"/><Run Text=" s"/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Vorschau + Einstellungen -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="160 × 32 px · 4-fach"/>
              <TextBlock x:Name="PreviewTitle" Style="{StaticResource H2}" Margin="0" Text="Auf der Tastatur"/>
            </DockPanel>
            <Border Background="#0B0B0C" CornerRadius="8" Padding="16" HorizontalAlignment="Left">
              <Image x:Name="Preview" Width="640" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"/>
            </Border>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="◀" ToolTip="Vorheriges Applet" Click="Prev_Click" Margin="0,0,6,0" MinWidth="44"/>
              <Button Content="▶" ToolTip="Nächstes Applet" Click="Next_Click" Margin="0,0,6,0" MinWidth="44"/>
              <Button x:Name="PauseButton" Content="Rotation anhalten" Click="Pause_Click" Margin="0,0,6,0"/>
              <Button Style="{StaticResource AccentButton}" Content="Layout bearbeiten" Click="Edit_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" x:Name="SettingsCard">
          <StackPanel>
            <TextBlock x:Name="SettingsTitle" Style="{StaticResource H2}" Text="Einstellungen"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Name"/>
                <TextBox x:Name="NameBox" LostFocus="Settings_Changed"/>
                <TextBlock Style="{StaticResource Label}" Text="Anzeigedauer"/>
                <ComboBox x:Name="DurationBox" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Label}" Text="Aktualisierung"/>
                <ComboBox x:Name="RefreshBox" SelectionChanged="Settings_Changed"/>
                <CheckBox x:Name="WarnBox" Margin="0,22,0,0" Click="Settings_Changed"
                          Content="Bei Warnwert sofort anzeigen"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Label}" Text="Verwendete Sensoren"/>
            <TextBlock x:Name="SensorList" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#D4D6DB"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
