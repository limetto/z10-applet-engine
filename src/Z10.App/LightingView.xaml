<UserControl x:Class="Z10.App.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button x:Name="WriteButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Auf Tastatur schreiben"
                    Click="Write_Click" Margin="8,0,0,0"
                    ToolTip="Speichert die Einstellungen im aktiven Profil der Tastatur (dauert ca. 15 Sekunden)"/>
            <Button x:Name="ReadButton" DockPanel.Dock="Right" Content="Von Tastatur lesen" Click="Read_Click"/>
            <TextBlock Text="Tastenbeleuchtung" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
          </DockPanel>
          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="–"/>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Effekt" Style="{StaticResource Label}"/>
              <ComboBox x:Name="EffectBox" SelectionChanged="Effect_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <DockPanel>
                <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                <TextBlock Text="Helligkeit" Style="{StaticResource Label}"/>
              </DockPanel>
              <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                      TickPlacement="BottomRight" ValueChanged="Brightness_Changed"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Tastenauswahl" Style="{StaticResource H2}" Margin="0"/>
          </DockPanel>
          <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          <WrapPanel x:Name="GroupPanel" Margin="0,12,0,0"/>
          <Viewbox Stretch="Uniform" MaxHeight="360" Margin="0,16,0,0" HorizontalAlignment="Left">
            <Canvas x:Name="KeyCanvas"/>
          </Viewbox>
          <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                     Text="Klick auf eine Taste schaltet sie an oder aus, Gruppen schalten alle Tasten der Gruppe um. Gestrichelte Tasten (&lt; und #) haben keine LED. Die Reihenfolge der E-Tasten ist noch nicht geprüft."/>
        </StackPanel>
      </Border>

      <Border Background="#2A2416" CornerRadius="8" Padding="12" Margin="0,16,0,0">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12"
                   Text="Die Einstellungen werden wie bei EVGA Unleash dauerhaft im aktiven Profil der Tastatur gespeichert. Während des Schreibens steht die Anzeige kurz still. Änderungen hier wirken erst nach „Auf Tastatur schreiben“."/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
