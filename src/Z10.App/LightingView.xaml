<UserControl x:Class="Z10.App.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button x:Name="WriteButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Auf Tastatur schreiben"
                    Click="Write_Click" Margin="8,0,0,0"
                    ToolTip="Speichert die Einstellungen im aktiven Profil der Tastatur (dauert ca. 15 Sekunden)"/>
            <Button x:Name="ReadButton" DockPanel.Dock="Right" Content="Von Tastatur lesen" Click="Read_Click"/>
            <TextBlock Text="Tastenbeleuchtung" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
          </DockPanel>
          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="–"/>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Effekt" Style="{StaticResource Label}"/>
              <ComboBox x:Name="EffectBox" SelectionChanged="Effect_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <DockPanel>
                <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                <TextBlock Text="Helligkeit" Style="{StaticResource Label}"/>
              </DockPanel>
              <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                      TickPlacement="BottomRight" ValueChanged="Brightness_Changed"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Displayfarbe" Style="{StaticResource H2}" Margin="0"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                     Text="Farbe der Displaybeleuchtung. Die Farbe wird nach dem Loslassen des Reglers an die Tastatur geschickt und bleibt dort auch nach dem Abstecken erhalten. „Auf Tastatur schreiben“ legt sie zusätzlich mit den übrigen Einstellungen im Profil ab."/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Border x:Name="ColorSwatch" Width="160" Height="64" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{StaticResource Line2Brush}" Background="Black">
                <TextBlock x:Name="ColorSwatchText" Text="Z10" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#101010"/>
              </Border>
              <TextBlock Text="Hex" Style="{StaticResource Label}"/>
              <TextBox x:Name="HexBox" Width="160" HorizontalAlignment="Left" LostFocus="Hex_Commit" KeyDown="Hex_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <DockPanel>
                <TextBlock x:Name="RValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Rot" Width="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="RSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="GValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Grün" Width="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="GSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="BValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Blau" Width="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="BSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" VerticalAlignment="Center"/>
              </DockPanel>
              <WrapPanel x:Name="PresetPanel" Margin="0,12,0,0"/>
              <CheckBox x:Name="AllProfilesBox" Margin="0,8,0,0" Content="Farbe in alle fünf Profile schreiben (sonst nur ins aktive)"
                        Checked="AllProfiles_Changed" Unchecked="AllProfiles_Changed"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Tastenauswahl" Style="{StaticResource H2}" Margin="0"/>
          </DockPanel>
          <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          <WrapPanel x:Name="GroupPanel" Margin="0,12,0,0"/>
          <Viewbox Stretch="Uniform" MaxHeight="360" Margin="0,16,0,0" HorizontalAlignment="Left">
            <Canvas x:Name="KeyCanvas"/>
          </Viewbox>
          <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                     Text="Klick auf eine Taste schaltet sie an oder aus, Gruppen schalten alle Tasten der Gruppe um. Gestrichelte Tasten haben keine LED. Das Layout der Grafik stellst du unter „Optionen“ ein."/>
        </StackPanel>
      </Border>

      <Border Background="#2A2416" CornerRadius="8" Padding="12" Margin="0,16,0,0">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12"
                   Text="Die Einstellungen werden wie bei EVGA Unleash dauerhaft im aktiven Profil der Tastatur gespeichert. Während des Schreibens steht die Anzeige kurz still. Änderungen hier wirken erst nach „Auf Tastatur schreiben“."/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
