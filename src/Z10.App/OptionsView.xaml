<UserControl x:Class="Z10.App.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
              <TextBlock Text="Display und Programm" Style="{StaticResource H2}"/>
              <TextBlock Text="Pause zwischen Display-Seiten" Style="{StaticResource Label}"/>
              <ComboBox x:Name="DelayBox" SelectionChanged="Delay_Changed"/>
              <CheckBox x:Name="ReleaseOnExitBox" Content="Beim Beenden Display an die Tastatur zurückgeben" Click="Behavior_Click" Margin="0,12,0,4"/>
              <CheckBox x:Name="BootBox" Content="Startanimation (auf der Tastatur und im Startfenster)" Click="Behavior_Click"/>
              <CheckBox x:Name="AutoStartBox" Content="Mit Windows starten (über die Aufgabenplanung, ohne UAC-Abfrage)" Click="AutoStart_Click"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
              <TextBlock Text="Sensoren" Style="{StaticResource H2}"/>
              <TextBlock Text="Abfragen alle" Style="{StaticResource Label}"/>
              <ComboBox x:Name="SensorIntervalBox" SelectionChanged="SensorInterval_Changed"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Häufiger abgefragt wird nur die Hardware, deren Sensoren gerade ein Applet braucht; alles andere alle 5 Sekunden. Manche Werte (z. B. Mainboard-Temperaturen) ändern sich in der Hardware selbst nur etwa jede Sekunde. Verläufe werden beim Umstellen neu begonnen."/>
              <TextBlock Text="Weitere Datenquellen" Style="{StaticResource H2}" Margin="0,20,0,4"/>
              <CheckBox x:Name="RtssBox" Content="RTSS (Framerate, Frametime)" Click="Sources_Click"/>
              <TextBlock x:Name="RtssStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
              <CheckBox x:Name="AfterburnerBox" Content="MSI Afterburner (alle Überwachungswerte)" Click="Sources_Click"/>
              <TextBlock x:Name="AfterburnerStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
              <CheckBox x:Name="AudioBox" Content="Lautstärke der Audiogeräte" Click="Sources_Click"/>
              <TextBlock x:Name="AudioStatus" Style="{StaticResource Hint}" Margin="26,0,0,6" Text="–"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                         Text="Framerate gibt es nur, wenn der RivaTuner Statistics Server läuft. Er ist ein eigenes Programm (Symbol im Infobereich), das mit Afterburner installiert wird. Afterburner allein liefert keine FPS."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Über" Style="{StaticResource H2}"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
              <Hyperlink NavigateUri="https://github.com/limetto/z10-applet-engine" RequestNavigate="Link_Navigate"><Run Text="Projektseite"/></Hyperlink>
              <Run Text=" · "/>
              <Hyperlink NavigateUri="https://github.com/limetto/z10-applet-engine/blob/main/LICENSE" RequestNavigate="Link_Navigate"><Run Text="Lizenz (MIT)"/></Hyperlink>
              <Run Text=" · "/>
              <Hyperlink NavigateUri="https://github.com/limetto/z10-applet-engine/blob/main/THIRD-PARTY-NOTICES.md" RequestNavigate="Link_Navigate"><Run Text="Verwendete Bibliotheken"/></Hyperlink>
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Inoffizielles Projekt ohne Verbindung zu EVGA. Sensorwerte von LibreHardwareMonitor (MPL 2.0)."/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Sprache und Tastatur" Style="{StaticResource H2}"/>
            <TextBlock Text="Sprache" Style="{StaticResource Label}"/>
            <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed"/>
            <DockPanel x:Name="RestartPanel" Margin="0,6,0,0" Visibility="Collapsed">
              <Button DockPanel.Dock="Right" Content="Jetzt neu starten" Click="Restart_Click" Margin="8,0,0,0"/>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="Die neue Sprache gilt nach einem Neustart."/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Vorlage für eine neue Sprache …" Click="LanguageTemplate_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Erstellt im Sprachordner eine Datei mit allen Texten. Übersetzen, als z. B. „fr.json“ speichern – danach steht die Sprache hier zur Auswahl."/>
            <TextBlock Text="Tastaturlayout (für die Beleuchtungsgrafik)" Style="{StaticResource Label}"/>
            <ComboBox x:Name="LayoutBox" SelectionChanged="Layout_Changed"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
              <TextBlock Text="Bildschirmschoner" Style="{StaticResource H2}"/>
              <CheckBox x:Name="SaverBox" Content="Bildschirmschoner auf dem Display" Click="Saver_Changed"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Nach" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="SaverMinutesBox" SelectionChanged="Saver_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Motiv" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="SaverKindBox" SelectionChanged="Saver_Changed"/>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="SaverMouseBox" Content="Mausbewegungen zählen auch als Eingabe" Click="Saver_Changed" Margin="0,8,0,0"/>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Vorschau (10 s)" Click="SaverPreview_Click"/>
                <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Startet, wenn so lange keine Taste gedrückt wurde. Der erste Tastendruck beendet ihn (E-Tasten schalten dabei nicht weiter)."/>
              </DockPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
              <TextBlock Text="Tasten E6 / E7" Style="{StaticResource H2}"/>
              <CheckBox x:Name="KeysBox" Content="E-Tasten auswerten" Click="Keys_Changed"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="E6" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="E6Box" Grid.Column="1" Margin="0,4" SelectionChanged="Keys_Changed"/>
                <TextBlock Grid.Row="1" Text="E7" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="E7Box" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="Keys_Changed"/>
              </Grid>
              <TextBlock x:Name="KeysStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="–"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
