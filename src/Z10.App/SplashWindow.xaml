<Window x:Class="Z10.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z10 Applet Engine" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Icon="app.ico"
        MouseLeftButtonDown="Skip_Click">
  <Border x:Name="Root" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
          CornerRadius="14" Padding="28,28,28,22">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>
    <StackPanel>
      <Border Background="#0B0B0C" CornerRadius="10" Padding="16">
        <Image x:Name="Lcd" Width="480" Height="96" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <DockPanel Margin="2,18,2,0">
        <TextBlock x:Name="Version" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" FontSize="12"/>
        <StackPanel>
          <TextBlock Text="Z10 Applet Engine" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="Status" Text="Starte …" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
