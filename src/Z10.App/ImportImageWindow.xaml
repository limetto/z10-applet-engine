<Window x:Class="Z10.App.ImportImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grafik importieren" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="app.ico" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Datei wählen …" Click="Browse_Click" Margin="8,0,0,0"/>
      <TextBlock x:Name="FileText" Text="PNG, JPG, BMP oder (animiertes) GIF wählen" Foreground="{StaticResource MutedBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <Border Background="#0B0B0C" CornerRadius="8" Padding="14" Margin="0,16,0,0">
      <Image x:Name="Preview" Width="640" Height="128" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left"/>
    </Border>
    <TextBlock x:Name="InfoText" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Vorschau in Displaygröße (160 × 32 px), 4-fach"/>

    <Grid Margin="0,12,0,0" x:Name="OptionsPanel" IsEnabled="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Name" Style="{StaticResource Label}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Größe in Pixeln (max. 160 × 32)" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="WidthBox" Width="70" TextChanged="Size_Changed"/>
          <TextBlock Text=" × " VerticalAlignment="Center" Margin="4,0"/>
          <TextBox x:Name="HeightBox" Width="70" TextChanged="Size_Changed"/>
          <CheckBox x:Name="KeepRatioBox" Content="Seitenverhältnis halten" IsChecked="True" Margin="12,0,0,0"/>
        </StackPanel>
        <WrapPanel Margin="0,6,0,0">
          <Button Content="8 px" Tag="8" Click="Preset_Click" Margin="0,0,6,6"/>
          <Button Content="16 px" Tag="16" Click="Preset_Click" Margin="0,0,6,6"/>
          <Button Content="24 px" Tag="24" Click="Preset_Click" Margin="0,0,6,6"/>
          <Button Content="32 px hoch" Tag="32" Click="Preset_Click" Margin="0,0,6,6"/>
          <Button Content="ganzes Display" Tag="full" Click="Preset_Click" Margin="0,0,6,6"/>
        </WrapPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <DockPanel>
          <TextBlock x:Name="ThresholdText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
          <TextBlock Text="Schwellwert (heller als … = Pixel an)" Style="{StaticResource Label}"/>
        </DockPanel>
        <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="254" Value="128" ValueChanged="Options_Changed"/>
        <CheckBox x:Name="DitherBox" Content="Rastern (Dithering, für Fotos und Verläufe)" Click="Options_Click"/>
        <CheckBox x:Name="InvertBox" Content="Invertieren (dunkle Bildteile leuchten)" Click="Options_Click"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                   Text="Transparente Bereiche bleiben dunkel. Für Logos auf weißem Grund „Invertieren“ verwenden."/>
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Abbrechen" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button x:Name="ImportButton" Style="{StaticResource AccentButton}" Content="Importieren" IsEnabled="False" Click="Import_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
