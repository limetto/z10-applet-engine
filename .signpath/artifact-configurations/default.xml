<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow (.github/workflows/release.yml).
  The workflow uploads the unsigned EXE with actions/upload-artifact, which wraps it in a ZIP.
  Only our own executable is signed; the bundled third-party libraries stay as they are.
  Paste this into the SignPath project as the default artifact configuration.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Z10AppletEngine.exe" product-name="Z10 Applet Engine" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
